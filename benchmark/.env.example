# EvoAgentBench environment variables
# Copy to .env and fill in your values

# OpenRouter API key (used by the example agent providers and, by default,
# Knowledge Work evaluation)
OPENROUTER_API_KEY=sk-or-v1-xxx

# Optional Knowledge Work evaluator override (OpenAI-compatible API)
# EVALUATION_API_BASE=http://localhost:8000/v1
# EVALUATION_API_KEY=EMPTY
# EVALUATION_MODEL=your-evaluator-model

# Information Retrieval LLM judge
JUDGE_MODEL=your-judge-model
JUDGE_API_BASE=http://localhost:8000/v1
JUDGE_API_KEY=sk-or-v1-xxx

# vLLM endpoint (used by the bundled 397B agent configs)
VLLM_API_BASE=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# Optional: set JAVA_HOME when Java 21 cannot be auto-detected.

# Optional: try this registry before loading/pulling SWE-bench images.
# SWEBENCH_REGISTRY=localhost:5000
